function renderGuide(){
 const g=$('#v-guide');if(g.dataset.ok)return;g.dataset.ok=1;
 const by={2:[],3:[],4:[],7:[]};NK.forEach(n=>by[NUT[n].g].push(NUT[n].n));
 const PAT=[['월','등푸른생선','F'],['화','소·양','B'],['수','해산물','S'],['목','등푸른생선','F'],['금','돼지','P'],['토','해산물·흰살','S'],['일','가벼운 날','V']];
 g.innerHTML=`<div class="gg">
<section class="card"><h3>섭취 간격 — 몸에 저장되는 만큼만</h3><div class="iv">
<div><b>2일</b><span>${by[2].join(' · ')}</span><small>거의 저장되지 않음 → 7일에 4회 이상</small></div>
<div><b>3일</b><span>${by[3].join(' · ')}</span><small>회전이 빠르거나 하루 필요량이 큼 → 7일에 3회</small></div>
<div><b>4일</b><span>${by[4].join(' · ')}</span><small>저장고가 작거나 조직에 천천히 쌓임 → 7일에 2회</small></div>
<div><b>7일</b><span>${by[7].join(' · ')}</span><small>간·지방에 저장 → 주 1회면 충분, 매일은 오히려 과잉</small></div></div>
<div class="note"><b>오메가3는 왜 3~4일 간격인가</b><p>EPA·DHA는 먹고 나서 혈중 농도가 1~2일이면 내려가지만, 적혈구와 세포막에는 몇 주~몇 달에 걸쳐 쌓입니다. 그래서 핵심은 주간 총량이고, 혈중 농도가 오래 비지 않도록 등푸른생선을 3~4일 간격으로 7일에 2번 배치했습니다. 목표는 주 3.5g(하루 평균 500mg) — 고등어·연어 한 토막이 대략 2~2.5g입니다.</p></div></section>
<section class="card"><h3>로테이션 규칙</h3><div class="pat">${PAT.map(p=>`<div style="--c:${CAT[p[2]].c}"><b>${p[0]}</b><i></i>${p[1]}</div>`).join('')}</div>
<ul style="margin-top:14px"><li>메뉴 ${D.length}개. 요일 칸 안에서 가장 오래 비어 있던 영양소를 채우는 메뉴를 고르고, 같은 메뉴는 21일 안에 다시 나오지 않습니다.</li><li>국물 메뉴는 어느 7일을 잘라도 최대 ${SALT_MAX}회, 직화 구이가 몰리면 수육·탕·회 쪽으로 돌립니다.</li><li>매일 다른 가게 유형의 대체 메뉴 2개를 같은 영양 기준으로 계산해, 겹치는 영양 비율과 빠지는 영양소를 보여줍니다. 대체로 바꾸면 그다음 날부터 빠진 영양소를 우선 채우도록 다시 계산됩니다.</li><li>두부·비빔밥처럼 단백질이 가벼운 날은 간식으로 계란·요거트·치즈를 우선 추천합니다.</li><li>제철(전어·대하 9~11월, 굴 10~3월, 방어·과메기 11~2월)은 자동 반영, 6~9월에는 날것을 뺍니다.</li><li>날짜 기준 계산이라 어느 기기에서 열어도 같은 날 같은 메뉴입니다.</li></ul></section>
<section class="card"><h3>빼는 것</h3><ul>
<li><b>닭·오리</b> — 전 메뉴에서 제외</li>
<li><b>가공육</b> — 햄·소시지·베이컨·스팸이 들어간 메뉴</li>
<li><b>정제 탄수화물</b> — 공기밥·면·사리·떡·빵·튀김옷은 요청사항으로 빼기. 비빔밥·덮밥류만 밥 1/3</li>
<li><b>정제당</b> — 단 양념(양념갈비·제육·떡볶이) 대신 소금구이·수육·탕·회. 초장·발사믹은 조금만</li>
<li><b>김치</b> — 외식·배달 김치는 수입산 비중이 높아 요청사항에서 빼기</li>
<li><b>곱창·순대·내장류</b> — 위생·유통 편차가 커서 제외</li>
<li><b>생 조개·굴, 여름철 날것</b> — 간이 약하면 비브리오 감염 위험이 커서 익힌 것만</li></ul></section>
<section class="card"><h3>1일1식 운용</h3><ul>
<li>한 끼 단백질 40g 이상 — 고기·생선 200g 안팎(손바닥 두 개)</li>
<li>채소 → 단백질 → (있다면) 밥 순서로, 천천히</li>
<li>국물은 1/3만 — 배달 국·탕 한 그릇의 나트륨이 하루 권고량(2,000mg)에 육박하는 경우가 많음</li>
<li>뜨거운 국물·찜은 받자마자 그릇에 옮겨 담기</li>
<li>식후 10~15분 걷기 — 오래 앉아 있는 날일수록</li>
<li>체중이 2주 넘게 계속 빠지면 간식을 매일로</li>
<li>눈: 20분마다 20초, 6m 이상 먼 곳 보기 · 물 1.5~2L</li></ul></section>
<section class="card"><h3>꼭 알아둘 것</h3><ul>
<li><b>비타민D</b> — 10~3월엔 햇빛 합성이 크게 줄어 식사만으론 부족하기 쉬움. 혈중 농도 검사 후 보충 고려</li>
<li><b>루테인·칼슘·콜린</b> — 배달 한 끼로 매주 채우기 가장 어려운 셋. 간식이 이 자리를 우선 채우도록 설계</li>
<li><b>와파린</b> 복용 중이면 청국장·잎채소·케일 녹즙 양을 들쭉날쭉하지 않게 (비타민K)</li>
<li><b>통풍·요산</b> 수치가 높으면 조개·등푸른생선 빈도 조절</li>
<li>브라질너트는 하루 2알 이하, 철분제는 검사 없이 먹지 않기</li>
<li>간·심장 질환 진단이 있거나 복용 중인 약이 있으면 담당 의사와 먼저 상의</li></ul>
<p class="sub" style="margin:12px 0 0">영양 표시는 일반 배달 1인분 기준 추정치입니다. 데치거나 끓인 채소의 비타민C·엽산은 계산에서 보수적으로 뺐습니다. 원산지는 배달앱 메뉴 상세의 원산지 표시로 확인하세요.</p></section>
</div>`;
}

function render(){
 TODAY=Math.max(0,tOf(todayStr()));
 build(Math.max(ANCHOR+7,SEL,TODAY)+21);
 const s=sOf(SEL),dt=new Date(Date.UTC(+s.slice(0,4),+s.slice(5,7)-1,+s.slice(8,10)));
 $('#hd').textContent=`${dt.getUTCMonth()+1}월 ${dt.getUTCDate()}일 ${WD[dt.getUTCDay()]}요일${SEL===TODAY?' · 오늘':''}`;
 document.querySelectorAll('#tabs button').forEach(b=>b.setAttribute('aria-current',b.dataset.tab===TAB?'page':'false'));
 ['today','week','menu','guide'].forEach(v=>$('#v-'+v).classList.toggle('hide',v!==TAB));
 ({today:renderToday,week:renderWeek,menu:renderMenu,guide:renderGuide})[TAB]();
}

document.addEventListener('click',e=>{
 const b=e.target.closest('button,[data-close]');if(!b)return;const o=b.dataset;
 if('copy' in o){copy(o.copy);return}
 if('tab' in o){TAB=o.tab;if(o.mcat){MF.cat=o.mcat;MF.nut='';MF.q=''}render();scrollTo(0,0);return}
 if('day' in o){SEL=+o.day;if(o.go){TAB=o.go;render();scrollTo(0,0)}else render();return}
 if('wk' in o){const v=+o.wk;if(v===0){ANCHOR=TODAY;SEL=TODAY}else{const off=SEL-ANCHOR;ANCHOR=Math.max(0,ANCHOR+7*v);SEL=ANCHOR+off}render();return}
 if('more' in o){const a=$('#alts');if(a)a.classList.toggle('hide');return}
 if('pick' in o){const key=sOf(SEL),orig=SCH.meal[SEL].orig.id,d=D.find(x=>x.id===o.pick),ok=avail(d,monthOf(SEL));
  if(o.pick===orig)delete OVR[key];else OVR[key]=o.pick;SCH=null;saveOvr();TAB='today';render();scrollTo(0,0);
  toast(ok?'메뉴를 바꿨어요 — 이후 추천도 다시 계산했어요':'지정했어요 · 제철이 아니거나 여름 날것이니 주의');return}
 if('unpick' in o){delete OVR[sOf(SEL)];SCH=null;saveOvr();render();toast('원래 추천으로 돌렸어요');return}
 if('mc' in o){MF.cat=o.mc;renderMenu();return}
 if('sheet' in o){$('#sheet').classList.remove('hide');return}
 if('close' in o){$('#sheet').classList.add('hide');return}
 if('dl' in o){dl();return}
 if('ct' in o){copy(makeIcs());return}
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')$('#sheet').classList.add('hide')});
document.addEventListener('visibilitychange',()=>{if(document.hidden)return;const nt=Math.max(0,tOf(todayStr()));if(nt!==TODAY){if(ANCHOR===TODAY)ANCHOR=nt;if(SEL===TODAY)SEL=nt;render()}});

$('#tabs').innerHTML=[['today','오늘'],['week','주간'],['menu','메뉴 '+D.length],['guide','원칙']].map(([k,n])=>`<button data-tab="${k}">${IC[k]}<span>${n}</span></button>`).join('');
$('#bell').innerHTML=IC.bell;$('#xbtn').innerHTML=IC.x;
(async()=>{TODAY=Math.max(0,tOf(todayStr()));SEL=ANCHOR=TODAY;await loadOvr();render()})();
</script>
</body>
</html>
