/* 스케줄: 날짜 기준 결정적 계산
   1) 요일 칸(SLOT) 안에서 2) 가장 오래 비어 있는 영양소를 채우는 메뉴 3) 21일 내 중복 금지
   4) 국물 메뉴는 7일에 최대 3회, 직화 구이 몰림 완화 5) 다른 가게 유형의 대체 메뉴 2개를 같은 기준으로 계산 */
let OVR={},SCH=null;
function reset(){SCH={meal:[],snack:[],alts:[],bk:[],lm:{},la:{},ld:{},ls:{}}}
function urg(map,n,t){const l=map[n];return l===undefined?2:Math.min(2,(t-l)/NUT[n].g)}
function pickBk(t,m,U,mo,pen,s){
 const cats=SLOT[t%7],W=m.tags.map(n=>Math.max(.25,U[n])*NUT[n].w),tot=W.reduce((a,b)=>a+b,0)||1;
 const c=D.filter(d=>d!==m&&cats.includes(d.cat)&&avail(d,mo)).map(d=>{
  const match=m.tags.reduce((a,n,i)=>a+(d.tags.includes(n)?W[i]:0),0)/tot;
  const fresh=s.ld[d.id]===undefined||t-s.ld[d.id]>=10;
  return{d,match,v:match*10+(d.shop!==m.shop?2.5:-4)+d.ub*.8+(fresh?1:-1)+pen(d)*.5+Math.min(d.o3,2.5)*.4}});
 c.sort((a,b)=>b.v-a.v||D.indexOf(a.d)-D.indexOf(b.d));
 const out=[];for(const x of c){if(out.length===2)break;if(out.some(y=>y.d.shop===x.d.shop))continue;out.push(x)}
 return out.map(x=>({d:x.d,match:Math.round(x.match*100),miss:m.tags.filter(n=>!x.d.tags.includes(n))}));
}
function build(upto){
 if(!SCH)reset();const s=SCH;
 for(let t=s.meal.length;t<=upto;t++){
  const mo=monthOf(t),cats=SLOT[t%7];
  const cnt=f=>{let c=0;for(let u=Math.max(0,t-6);u<t;u++)if(s.meal[u].d[f])c++;return c};
  const nS=cnt('salt'),nG=cnt('grill');
  const pen=d=>(d.salt?(nS>=SALT_MAX?-50:nS>=SALT_MAX-1?-3:0):0)+(d.grill&&nG>=3?-2:0);
  const U={};NK.forEach(n=>U[n]=urg(s.lm,n,t));
  let c=D.filter(d=>cats.includes(d.cat)&&avail(d,mo));
  const f=c.filter(d=>s.ld[d.id]===undefined||t-s.ld[d.id]>=REPEAT);if(f.length)c=f;
  const sc=c.map(d=>({d,v:d.tags.reduce((a,n)=>a+U[n]*NUT[n].w,0)+d.o3*.5+(s.ld[d.id]===undefined?8:Math.min(8,(t-s.ld[d.id])/7))+pen(d)}));
  sc.sort((a,b)=>b.v-a.v||D.indexOf(a.d)-D.indexOf(b.d));
  const orig=sc.length?sc[0].d:D[0];let m=orig,ovr=false;
  const o=OVR[sOf(t)];if(o){const od=D.find(x=>x.id===o);if(od&&od!==orig){m=od;ovr=true}}
  s.meal[t]={d:m,ovr,orig};
  s.bk[t]=pickBk(t,m,U,mo,pen,s);
  s.alts[t]=sc.map(x=>x.d).filter(x=>x!==m).slice(0,6);
  m.tags.forEach(n=>{s.lm[n]=t;s.la[n]=t});s.ld[m.id]=t;
  const sn=SN.filter(x=>!x.months||x.months.includes(mo)).map(x=>({x,v:x.tags.reduce((a,n)=>a+(m.tags.includes(n)?0:urg(s.la,n,t)*NUT[n].w),0)+(m.lite&&x.pro?3:0)+(s.ls[x.id]===undefined?1:Math.min(1,(t-s.ls[x.id])/14))-(s.ls[x.id]!==undefined&&t-s.ls[x.id]<3?5:0)}));
  sn.sort((a,b)=>b.v-a.v||SN.indexOf(a.x)-SN.indexOf(b.x));
  const k=sn[0].x;s.snack[t]=k;k.tags.forEach(n=>s.la[n]=t);s.ls[k.id]=t;
 }
}
function stats(t0){
