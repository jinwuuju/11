 const ev=(t,hm,tag,sum,desc)=>{const day=sOf(t).replace(/-/g,''),[h,m]=hm.split(':');L.push('BEGIN:VEVENT','UID:hankki-'+day+'-'+tag+'@omad','DTSTAMP:'+stamp,'DTSTART:'+day+'T'+h+m+'00','DURATION:PT30M','SUMMARY:'+icsEsc(sum),'DESCRIPTION:'+icsEsc(desc),'BEGIN:VALARM','ACTION:DISPLAY','TRIGGER:-PT0M','DESCRIPTION:'+icsEsc(sum),'END:VALARM','END:VEVENT')};
 for(let i=0;i<n;i++){const t=TODAY+i,d=SCH.meal[t].d,k=SCH.snack[t],bk=SCH.bk[t];
  ev(t,tl,'L','🍽 '+d.name,['검색: '+d.kw,d.req?'요청사항: '+d.req:'',d.tip,d.org?'원산지: '+d.org:'',d.salt?'국물은 1/3만':'',d.lite?'단백질이 가벼운 메뉴 — 간식으로 보강':'','영양: '+d.tags.map(nn).join(', '),bk.length?'배달 안 되면: '+bk.map(b=>b.d.name+'('+b.match+'%)').join(' / '):''].filter(Boolean).join('\n'));
  if(sk)ev(t,ts,'S','간식(선택) · '+k.name,'보충: '+k.tags.map(nn).join(', ')+(k.extra?'\n'+k.extra:''));
 }
 L.push('END:VCALENDAR');return L.map(fold).join('\r\n')+'\r\n';
}
