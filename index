<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>한 끼 · 1일1식 영양 로테이션</title>
<style>
:root{--bg:#f5f5f2;--card:#fff;--ink:#151514;--sub:#6e6e69;--mute:#a5a59f;--line:#e8e7e2;--soft:#f0efea;--acc:#0e7a5b;--acc-s:#e2f1eb;--warn:#b25e09;--warn-s:#fbf1e3;--bad:#c0392b;--r:18px;--sh:0 1px 2px rgba(20,20,10,.04),0 6px 20px rgba(20,20,10,.04);--cF:#2563eb;--cB:#c2410c;--cL:#a16207;--cP:#db2777;--cS:#0891b2;--cW:#64748b;--cV:#65a30d}
@media (prefers-color-scheme:dark){:root{--bg:#0e0e0d;--card:#171716;--ink:#f1f1ee;--sub:#a3a39d;--mute:#6a6a65;--line:#2a2a27;--soft:#20201e;--acc:#3ccf9f;--acc-s:#12302a;--warn:#f2a54a;--warn-s:#33260f;--bad:#ff7a6b;--sh:none}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo",Pretendard,"Noto Sans KR","Malgun Gothic",sans-serif;letter-spacing:-.01em;word-break:keep-all;-webkit-font-smoothing:antialiased}
button,input,select{font:inherit;color:inherit}
button{background:none;border:0;padding:0;cursor:pointer;text-align:inherit}
.hide{display:none!important}
.wrap{max-width:1120px;margin:0 auto;padding:0 16px}
.top{position:sticky;top:0;z-index:20;background:var(--bg)}
.top .wrap{display:flex;align-items:center;gap:12px;height:60px}
.brand{display:flex;flex-direction:column;line-height:1.25;margin-right:auto}
.brand b{font-size:17px;letter-spacing:-.02em}
.brand span{font-size:12.5px;color:var(--sub)}
.ib{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;color:var(--sub);flex:none}
.ib:hover{background:var(--soft);color:var(--ink)}
.ib svg{width:20px;height:20px}
.ib[disabled]{opacity:.3;pointer-events:none}
.tabs{display:flex;gap:4px}
.tabs button{display:flex;align-items:center;gap:6px;padding:8px 12px;border-radius:10px;color:var(--sub);font-size:14px;font-weight:600}
.tabs button svg{width:18px;height:18px}
.tabs button[aria-current=page]{color:var(--ink);background:var(--card);box-shadow:var(--sh)}
main{padding-bottom:48px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px;box-shadow:var(--sh)}
.stack{display:grid;gap:12px;align-content:start}
.today{display:grid;gap:12px}
@media(min-width:960px){.today{grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);gap:16px;align-items:start}.today>.full{grid-column:1/-1}.today .side{position:sticky;top:72px}}
.lbl{font-size:12px;font-weight:600;color:var(--sub)}
.sub{color:var(--sub);font-size:13px}
.hd{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:14px}
.hd h3{margin:0;font-size:16px;letter-spacing:-.02em}
.wkh{display:flex;align-items:center;gap:4px;margin:6px 0 10px}
.wkh h3{margin:0 auto 0 2px;font-size:14px;font-weight:650;font-variant-numeric:tabular-nums}
.wkh .ib{width:34px;height:34px}
.chipbtn{font-size:12.5px;font-weight:600;padding:6px 11px;border-radius:999px;background:var(--card);border:1px solid var(--line);margin-right:4px}
.strip{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.day{display:flex;flex-direction:column;align-items:center;gap:1px;padding:8px 0 10px;border-radius:14px;background:var(--card);border:1px solid var(--line)}
.day .w{font-size:11px;color:var(--sub);font-weight:600}
.day .n{font-size:17px;font-weight:650;font-variant-numeric:tabular-nums}
.day i{width:6px;height:6px;border-radius:50%;background:var(--c);margin-top:3px}
.day.today .n{color:var(--acc)}
.day.on{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.day.on .w,.day.on .n{color:inherit}.day.on .w{opacity:.65}
.row1{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.cat{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--sub);margin-right:auto}
.cat::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--c)}
.badge{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--soft);color:var(--sub);white-space:nowrap}
.badge.w{background:var(--warn-s);color:var(--warn)}.badge.a{background:var(--acc-s);color:var(--acc)}
.meal h2{font-size:clamp(24px,5.6vw,30px);line-height:1.22;letter-spacing:-.03em;margin:6px 0 6px;font-weight:750}
.meal .tip{margin:0 0 16px;color:var(--sub)}
.req{display:flex;align-items:center;gap:12px;background:var(--soft);border-radius:14px;padding:12px 12px 12px 14px}
.req p{margin:2px 0 0;font-size:14px;line-height:1.45}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;padding:0 16px;border-radius:12px;background:var(--ink);color:var(--bg);font-weight:650;font-size:14px;white-space:nowrap}
.btn.sm{height:34px;padding:0 12px;font-size:13px;border-radius:10px}
.btn.gh{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.kv{display:grid;grid-template-columns:52px 1fr;gap:8px 12px;font-size:13.5px;margin:16px 0}
.kv dt{color:var(--sub)}.kv dd{margin:0}
.lnk{color:var(--acc);font-weight:600;font-size:13px;margin-left:6px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:3px 10px;border-radius:999px;border:1px solid var(--line);white-space:nowrap}
.chip.x{border-style:dashed;color:var(--sub)}
.chip.cc::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--c)}
.bk{margin-top:18px;display:grid;gap:8px}
.bkr{display:grid;grid-template-columns:8px minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 10px 10px 12px;border:1px solid var(--line);border-radius:14px}
.bkr>i{width:8px;height:8px;border-radius:50%;background:var(--c)}
.bkr b{display:block;font-size:14px;font-weight:650}
.bkr small{display:block;font-size:12px;color:var(--sub);line-height:1.45}
.pct{font-variant-numeric:tabular-nums;color:var(--acc);font-weight:650}
.foot{display:flex;justify-content:flex-end;align-items:center;gap:6px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);flex-wrap:wrap}
.alts{display:grid;gap:6px;margin-top:12px}
.alt{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;border:1px solid var(--line);width:100%}
.alt:hover{background:var(--soft)}
.alt i{width:8px;height:8px;border-radius:50%;background:var(--c);flex:none}
.alt b{font-weight:600;font-size:14px}.alt small{display:block;color:var(--sub);font-size:12px}
.snack h3{margin:8px 0 4px;font-size:18px;letter-spacing:-.02em}
.snack p{margin:0;font-size:13.5px;color:var(--sub)}
.o3{padding:14px;border-radius:14px;background:var(--soft);margin-bottom:12px}
.o3 .v{display:flex;align-items:baseline;gap:6px;margin:4px 0 8px;flex-wrap:wrap}
.o3 .v b{font-size:24px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.bar{position:relative;height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.bar b{position:absolute;top:0;bottom:0;left:0;border-radius:3px;background:var(--bc,var(--acc))}
.bar b.s{opacity:.3}
.gs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.g{padding:12px;border-radius:14px;border:1px solid var(--line)}
.g .n{font-size:12.5px;color:var(--sub);font-weight:600}
.g .v{font-size:24px;font-weight:750;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.2;margin:2px 0 1px}
.g .v span{font-size:13px;font-weight:600}
.g small{display:block;font-size:11px;color:var(--sub);margin-bottom:8px}
.legend{display:flex;gap:14px;align-items:center;font-size:12px;color:var(--sub);margin:12px 2px 0;flex-wrap:wrap}
.legend span{display:inline-flex;align-items:center;gap:6px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--line);display:block;margin:auto}
.dot.m{background:var(--acc)}.dot.s{background:transparent;box-shadow:inset 0 0 0 2px var(--acc)}
.legend .dot{margin:0}
details>summary{list-style:none;cursor:pointer}
details>summary::-webkit-details-marker{display:none}
.nts{margin-top:14px;border-top:1px solid var(--line)}
.nts>summary{padding:12px 2px 6px;font-size:13.5px;font-weight:600;display:flex;justify-content:space-between}
.nts>summary::after{content:"＋";color:var(--sub)}.nts[open]>summary::after{content:"－"}
.ng{display:grid;grid-template-columns:88px repeat(7,minmax(0,1fr)) 40px;align-items:stretch}
.ng>span{display:flex;align-items:center;justify-content:center;min-height:34px}
.ng>span.cur{background:var(--soft)}
.ng .nn{justify-content:flex-start;font-size:12.5px;font-weight:600}
.ng .fr{justify-content:flex-end;font-size:12px;font-variant-numeric:tabular-nums;color:var(--warn);font-weight:650}
.ng .fr.ok{color:var(--acc)}.ng .fr.sn{color:var(--sub)}
.ng.hdr>span{font-size:11px;color:var(--sub);min-height:26px}
.nr>summary{border-top:1px solid var(--line)}
.nd{padding:6px 2px 12px;font-size:13px;color:var(--sub)}
.nd p{margin:3px 0}.nd b{color:var(--ink);font-weight:600}
.habit{font-size:12.5px;color:var(--sub);text-align:center;margin:8px 0 0}
.wl{padding:4px 20px}
.wi{display:grid;grid-template-columns:44px 3px minmax(0,1fr) auto;gap:14px;align-items:center;width:100%;padding:14px 0;border-top:1px solid var(--line)}
.wi:first-child{border-top:0}
.wi .wd{display:flex;flex-direction:column;line-height:1.25}
.wi .wd b{font-size:15px}.wi .wd small{font-size:12px;color:var(--sub);font-variant-numeric:tabular-nums}
.wi>i{align-self:stretch;border-radius:2px;background:var(--c)}
.wi .wm{min-width:0}
.wi .wm b{display:block;font-size:15px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wi .wm small{display:block;font-size:12.5px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wi.on .wd b{color:var(--acc)}
.wgrid{display:grid;gap:12px}
@media(min-width:960px){.wgrid{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);align-items:start}}
.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.kpi div{padding:10px;border-radius:12px;background:var(--soft)}
.kpi b{display:block;font-size:18px;font-variant-numeric:tabular-nums}
.kpi small{font-size:11.5px;color:var(--sub)}
.mf{display:flex;gap:8px;margin:8px 0 10px}
.mf input,.mf select{height:42px;border-radius:12px;border:1px solid var(--line);background:var(--card);padding:0 12px;font-size:15px;min-width:0}
.mf input{flex:1}
.seg{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;scrollbar-width:none}
.seg::-webkit-scrollbar{display:none}
.seg button{flex:none;height:34px;padding:0 13px;border-radius:999px;border:1px solid var(--line);background:var(--card);font-size:13px;font-weight:600;color:var(--sub)}
.seg button.on{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.list{padding:4px 18px}
.lh{font-size:12px;color:var(--sub);padding:12px 0 8px}
.mi{border-top:1px solid var(--line)}
.mi>summary{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:10px;align-items:center;padding:12px 0}
.mi .no{font-size:12px;color:var(--mute);font-variant-numeric:tabular-nums}
.mi .mn b{display:block;font-weight:600;font-size:15px}
.mi .mn small{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--sub)}
.mi .mn small::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--c);flex:none}
.mi .mt{font-size:12px;color:var(--sub);text-align:right}
.md{padding:0 0 16px 36px;display:grid;gap:10px;font-size:13.5px}
.gg{display:grid;gap:12px;margin-top:8px}
@media(min-width:960px){.gg{grid-template-columns:1fr 1fr;align-items:start}}
.gg h3{margin:0 0 12px;font-size:16px}
.gg ul{margin:0;padding-left:18px;display:grid;gap:7px;font-size:14px}
.gg li::marker{color:var(--mute)}
.iv{display:grid;gap:8px}
.iv>div{display:grid;grid-template-columns:40px 1fr;column-gap:12px;padding:10px 12px;border-radius:12px;background:var(--soft)}
.iv b{grid-row:span 2;font-size:15px}
.iv span{font-size:14px;font-weight:600}
.iv small{font-size:12px;color:var(--sub)}
.note{margin-top:12px;padding:14px;border-radius:12px;border:1px solid var(--line);font-size:13.5px}
.note p{margin:6px 0 0;color:var(--sub)}
.pat{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;text-align:center;font-size:11.5px;line-height:1.3}
.pat div{padding:8px 2px;border-radius:10px;background:var(--soft)}
.pat b{display:block;font-size:13px}
.pat i{display:block;width:8px;height:8px;border-radius:50%;margin:6px auto 4px;background:var(--c)}
.sheet{position:fixed;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center}
.sheet .bd{position:absolute;inset:0;background:rgba(0,0,0,.36)}
.sheet .sc{position:relative;width:100%;max-width:520px;max-height:90vh;overflow:auto;background:var(--card);border-radius:22px 22px 0 0;padding:20px 20px calc(20px + env(safe-area-inset-bottom))}
@media(min-width:760px){.sheet{align-items:center}.sheet .sc{border-radius:22px}}
.form{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}
.form label{display:grid;gap:4px;font-size:12px;color:var(--sub);font-weight:600}
.form input[type=time],.form select{height:42px;border-radius:12px;border:1px solid var(--line);background:var(--bg);padding:0 10px;font-size:15px;color:var(--ink)}
.form .ck{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink);grid-column:1/-1}
.steps{margin:16px 0 0;padding-left:18px;font-size:13px;color:var(--sub);display:grid;gap:4px}
.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,12px);opacity:0;pointer-events:none;background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-size:14px;font-weight:600;transition:.2s;z-index:70;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:759px){
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--card);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.tabs button{flex-direction:column;gap:2px;font-size:11px;padding:6px 0;justify-content:center}
.tabs button svg{width:22px;height:22px}
.tabs button[aria-current=page]{background:none;box-shadow:none}
main{padding-bottom:calc(92px + env(safe-area-inset-bottom))}
.toast{bottom:calc(92px + env(safe-area-inset-bottom))}
}
@media(max-width:520px){.card{padding:16px}.wl,.list{padding:4px 16px}.mi .mt{display:none}.md{padding-left:0}.g{padding:10px}.g .v{font-size:21px}}
</style>
</head>
<body>
<header class="top"><div class="wrap">
<div class="brand"><b>한 끼</b><span id="hd"></span></div>
<nav class="tabs" id="tabs"></nav>
<button class="ib" data-sheet aria-label="캘린더 알림" id="bell"></button>
</div></header>
<main class="wrap">
<section id="v-today"></section>
<section id="v-week" class="hide"></section>
<section id="v-menu" class="hide"></section>
<section id="v-guide" class="hide"></section>
</main>
<div id="sheet" class="sheet hide"><div class="bd" data-close></div>
<div class="sc" role="dialog" aria-label="캘린더 알림">
<div class="hd"><h3>캘린더 알림 (.ics)</h3><button class="ib" data-close aria-label="닫기" id="xbtn"></button></div>
<p class="sub" style="margin:0">아이폰·갤럭시 기본 캘린더에 매일 메뉴, 요청사항, 대체 메뉴가 알림으로 뜹니다. 앱 설치 없음.</p>
<div class="form">
<label>기간<select id="icN"><option value="14">2주</option><option value="30" selected>30일</option><option value="60">60일</option><option value="90">90일</option></select></label>
<label>점심 알림<input id="icL" type="time" value="11:00"></label>
<label class="ck"><input id="icS" type="checkbox" checked> 간식 알림도 받기</label>
<label>간식 알림<input id="icT" type="time" value="15:30"></label>
</div>
<div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn" data-dl>.ics 다운로드</button><button class="btn gh" data-ct>텍스트 복사</button></div>
<ol class="steps"><li>Safari(또는 크롬)에서 이 페이지를 열고 다운로드 — 미리보기에서 막히면 새 창에서 열기</li><li>파일을 탭 → 모두 추가 → 새 캘린더 "식단"을 만들어 넣기</li><li>메뉴를 바꾸거나 기간이 끝나면 "식단" 캘린더를 지우고 다시 내보내기</li></ol>
</div></div>
<div id="toast" class="toast" role="status"></div>
<script>
const EPOCH='2026-01-05',REPEAT=21,RAW_OFF=[6,7,8,9],O3T=3.5,SALT_MAX=3;
const CAT={F:{n:'등푸른생선',c:'var(--cF)'},B:{n:'소고기',c:'var(--cB)'},L:{n:'양고기',c:'var(--cL)'},P:{n:'돼지고기',c:'var(--cP)'},S:{n:'조개·해산물',c:'var(--cS)'},W:{n:'흰살생선',c:'var(--cW)'},V:{n:'두부·계란·채소',c:'var(--cV)'}};
const SHOP={sal:'샐러드·포케',gri:'생선구이집',raw:'횟집',eel:'장어집',bbq:'고깃집',soup:'국·탕집',shabu:'샤브·전골',west:'양식',bossam:'보쌈집',sea:'해물찜·탕',hansik:'한식 정식',lamb:'양고기집',yuk:'육회집',don:'덮밥집'};
const UB={3:'어디서나',2:'흔함',1:'지역 따라'};
const SLOT=[['F'],['B','L'],['S'],['F'],['P'],['S','W'],['V','W','B']];
const NUT={
o3:{n:'오메가3',g:4,w:1.3,why:'EPA·DHA. 혈중 중성지방과 혈관 염증을 낮추고, DHA는 망막의 주성분.',src:'고등어·연어·삼치·장어'},
d:{n:'비타민D',g:7,w:1.2,why:'혈관·면역·근육 기능. 실내 근무자는 대부분 부족.',src:'등푸른생선·갈치·장어·계란 노른자'},
lut:{n:'루테인',g:3,w:1.2,why:'황반 색소 밀도를 유지해 화면 청색광·눈 피로로부터 보호.',src:'케일·시금치·깻잎·계란 노른자'},
