  for(let i=0;i<7;i++){const t=t0+i,m=SCH.meal[t].d.tags.includes(n),s=SCH.snack[t].tags.includes(n);cells.push(m?2:s?1:0);if(m)mc++;if(m||s)ac++}
  return{n,cells,mc,ac,req:Math.ceil(7/NUT[n].g)}});
 const by={};rows.forEach(r=>by[r.n]=r);
 const sc=(r,k)=>Math.min(1,r[k]/r.req);
 const groups=GROUPS.map(g=>({n:g.n,ms:g.ns.reduce((a,n)=>a+sc(by[n],'mc'),0)/g.ns.length,as:g.ns.reduce((a,n)=>a+sc(by[n],'ac'),0)/g.ns.length}));
 let o3=0,salt=0,grill=0,red=0;
 for(let i=0;i<7;i++){const d=SCH.meal[t0+i].d;o3+=d.o3;if(d.salt)salt++;if(d.grill)grill++;if('BLP'.includes(d.cat))red++}
 return{rows,groups,o3,salt,grill,red};
}
