 return `<div class="wkh"><h3>${md(ANCHOR)} – ${md(ANCHOR+6)}${cur?' · 앞으로 7일':''}</h3>${cur?'':'<button class="chipbtn" data-wk="0">오늘부터</button>'}<button class="ib" data-wk="-1" aria-label="이전 7일" ${ANCHOR<=0?'disabled':''}>${IC.l}</button><button class="ib" data-wk="1" aria-label="다음 7일">${IC.r}</button></div>`}
function stripH(){let h='<div class="strip">';for(let i=0;i<7;i++){const t=ANCHOR+i,d=SCH.meal[t].d;
 h+=`<button class="day${t===SEL?' on':''}${t===TODAY?' today':''}" data-day="${t}" style="--c:${CAT[d.cat].c}" aria-label="${md(t)} ${esc(d.name)}"><span class="w">${t===TODAY?'오늘':wd(t)}</span><span class="n">${Number(sOf(t).slice(8))}</span><i></i></button>`}return h+'</div>'}

