 const alts=SCH.alts[SEL].filter(a=>!bk.some(b=>b.d===a)).map(a=>`<button class="alt" data-pick="${a.id}" style="--c:${CAT[a.cat].c}"><i></i><span><b>${a.name}${a===M.orig?' · 원래 추천':''}</b><small>${SHOP[a.shop]} · ${a.tags.slice(0,5).map(nn).join(' · ')}</small></span></button>`).join('');
 return `<article class="card meal" style="--c:${CAT[d.cat].c}">
<div class="row1"><span class="cat">${CAT[d.cat].n}</span>${badges}</div>
<div class="lbl" style="margin-top:14px">${isT?'오늘':md(SEL)+' ('+wd(SEL)+')'} 점심 · 배달</div>
<h2>${d.name}</h2><p class="tip">${d.tip}</p>
<div class="req"><div style="flex:1;min-width:0"><div class="lbl">요청사항</div><p>${d.req||'특별히 없음'}</p></div>${d.req?`<button class="btn sm" data-copy="${esc(d.req)}">복사</button>`:''}</div>
<dl class="kv"><dt>검색어</dt><dd>${d.kw}<button class="lnk" data-copy="${esc(d.kw)}">복사</button></dd><dt>가게</dt><dd>${SHOP[d.shop]} · ${UB[d.ub]}${o3s(d)}</dd>${d.org?`<dt>원산지</dt><dd>${d.org}</dd>`:''}${d.salt?'<dt>나트륨</dt><dd>국물은 1/3만, 건더기 위주로</dd>':''}${d.raw?'<dt>날것</dt><dd>6~9월에는 자동으로 제외됩니다</dd>':''}</dl>
<div class="chips">${chips}</div>
${bk.length?`<div class="bk"><div class="lbl">배달이 안 되면 · 다른 가게 유형</div>${bkh}</div>`:''}
<div class="foot">${M.ovr?'<button class="lnk" data-unpick>원래 추천으로</button>':''}<button class="lnk" data-more>후보 더 보기</button><button class="lnk" data-tab="menu" data-mcat="${d.cat}">전체 메뉴</button></div>
<div id="alts" class="alts hide">${alts||'<p class="sub">다른 후보 없음</p>'}</div>
</article>`}

function snackCard(){
 const d=SCH.meal[SEL].d,k=SCH.snack[SEL],fill=k.tags.filter(n=>!d.tags.includes(n)),pro=d.lite&&k.pro;
 const msg=[pro?'단백질 보강':'',fill.length?'식사에 없는 '+fill.map(nn).join('·')+' 채움':(!pro?'식사 영양을 한 번 더 보강':'')].filter(Boolean).join(' · ');
 return `<article class="card snack"><div class="row1"><span class="lbl" style="margin-right:auto">간식 · 선택</span>${fill.length?`<span class="badge a">+${fill.length} 보충</span>`:''}</div>
<h3>${k.name}</h3><p>${msg}${k.extra?' · '+k.extra:''}</p></article>`}

function covCard(){
 const st=stats(ANCHOR);
 let last=null;for(let t=SEL;t>=Math.max(0,SEL-14);t--){if(SCH.meal[t].d.o3>=1){last=t;break}}
 let nx=null;for(let t=SEL+1;t<=SEL+14;t++){if(SCH.meal[t].d.o3>=1){nx=t;break}}
 const o3t=(last===SEL?'이날 섭취':last!==null?(SEL-last)+'일 전 섭취':'2주 내 없음')+(nx?' · 다음 '+wd(nx)+' '+md(nx):'');
 const tiles=st.groups.map(g=>{const m=Math.round(g.ms*100),a=Math.round(g.as*100),bc=m>=85?'var(--acc)':m>=60?'var(--warn)':'var(--bad)';
  return `<div class="g" style="--bc:${bc}"><div class="n">${g.n}</div><div class="v">${m}<span>%</span></div><small>간식 포함 ${a}%</small><div class="bar"><b class="s" style="width:${a}%"></b><b style="width:${m}%"></b></div></div>`}).join('');
 let grid=`<div class="ng hdr"><span></span>${[0,1,2,3,4,5,6].map(i=>`<span class="${ANCHOR+i===SEL?'cur':''}">${wd(ANCHOR+i)}</span>`).join('')}<span></span></div>`;
 st.rows.forEach(r=>{const N=NUT[r.n],x=nextOf(r.n,SEL),cls=r.mc>=r.req?'ok':r.ac>=r.req?'sn':'';
  grid+=`<details class="nr"><summary><div class="ng"><span class="nn">${N.n}</span>${r.cells.map((c,i)=>`<span class="${ANCHOR+i===SEL?'cur':''}"><i class="dot ${c===2?'m':c===1?'s':''}"></i></span>`).join('')}<span class="fr ${cls}">${r.mc}${r.ac>r.mc?'<sup>+'+(r.ac-r.mc)+'</sup>':''}/${r.req}</span></div></summary>
<div class="nd"><p>${N.why}</p><p><b>간격</b> ${N.g}일 이내 · 7일에 ${r.req}회 이상 · <b>급원</b> ${N.src}</p><p><b>다음 식사</b> ${x?wd(x)+' '+md(x)+' · '+SCH.meal[x].d.name:'2주 안에 없음 — 간식으로 보충'}</p></div></details>`});
 return `<section class="card cov">
<div class="hd"><h3>7일 영양 밸런스</h3><span class="sub">큰 숫자 = 식사만</span></div>
<div class="o3"><div class="row1"><span class="lbl" style="margin-right:auto">EPA+DHA (오메가3)</span><span class="sub">${o3t}</span></div>
<div class="v"><b>${st.o3.toFixed(1)}g</b><span class="sub">/ 목표 ${O3T}g · 하루 평균 ${Math.round(st.o3/7*1000)}mg</span></div>
<div class="bar" style="--bc:${st.o3>=O3T?'var(--acc)':'var(--warn)'}"><b style="width:${Math.min(100,st.o3/O3T*100)}%"></b></div></div>
<div class="gs">${tiles}</div>
<div class="legend"><span><i class="dot m"></i>식사</span><span><i class="dot s"></i>간식으로 보충</span><span>국물 ${st.salt}/${SALT_MAX}회 · 붉은 고기 ${st.red}회</span></div>
<details class="nts" id="nts"${NTS?' open':''}><summary>영양소별 7일 보기</summary>${grid}</details>
</section>`}

